#!/bin/bash
# spotify-plugin-caelestia — event-driven Spotify wallpaper daemon
# https://github.com/vaishnav-mk/spotify-plugin-caelestia

export PATH=/usr/local/sbin:/usr/local/bin:/usr/bin

# ─── Load config ─────────────────────────────────────────────────
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/caelestia/spotify-plugin.conf"
[[ -f "$CONFIG" ]] && source "$CONFIG"

# ─── Defaults (overridden by config) ─────────────────────────────
COVER_SIZE=${COVER_SIZE:-480}
RADIUS=${RADIUS:-30}
BLUR_STRENGTH=${BLUR_STRENGTH:-30}
DARKEN_AMOUNT=${DARKEN_AMOUNT:-35}
FONT_BOLD=${FONT_BOLD:-"/usr/share/fonts/TTF/JetBrainsMonoNerdFont-Bold.ttf"}
FONT_REGULAR=${FONT_REGULAR:-"/usr/share/fonts/TTF/JetBrainsMonoNerdFont-Regular.ttf"}
TITLE_SIZE=${TITLE_SIZE:-40}
ARTIST_SIZE=${ARTIST_SIZE:-26}
MAX_CHARS=${MAX_CHARS:-28}
VERTICAL_OFFSET=${VERTICAL_OFFSET:--80}
PRIMARY_MONITOR=${PRIMARY_MONITOR:-0}
RETRY_DELAY=${RETRY_DELAY:-5}
MATCH_SCHEME=${MATCH_SCHEME:-false}
SCHEME_MODE=${SCHEME_MODE:-dark}
SCHEME_VARIANT=${SCHEME_VARIANT:-tonalspot}

# ─── Paths ───────────────────────────────────────────────────────
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/spotify-plugin-caelestia"
STATE_FILE="$HOME/.local/state/caelestia/wallpaper/path.txt"
mkdir -p "$CACHE"

# ─── Scheme state file ──────────────────────────────────────────
SCHEME_STATE="$HOME/.local/state/caelestia/spotify-plugin-scheme.json"
mkdir -p "$(dirname "$SCHEME_STATE")"

# ─── State ───────────────────────────────────────────────────────
original_wallpaper=""
last_trackid=""
original_scheme_saved=false

# ─── Helpers ─────────────────────────────────────────────────────
log() { echo "[$(date +%T)] $*"; }

trunc() {
    local text="$1"
    if (( ${#text} > MAX_CHARS )); then
        echo "${text:0:$MAX_CHARS}..."
    else
        echo "$text"
    fi
}

get_monitor_dims() {
    hyprctl monitors -j 2>/dev/null \
        | python3 -c "
import sys, json
monitors = json.load(sys.stdin)
idx = int('${PRIMARY_MONITOR}')
if idx < len(monitors):
    m = monitors[idx]
    print(m['width'], m['height'])
else:
    print(1920, 1080)
" 2>/dev/null || echo "1920 1080"
}

set_wallpaper() {
    local path="$1"
    # caelestia shell wallpaper set applies to all monitors by default
    caelestia shell wallpaper set "$path" 2>/dev/null
    log "Wallpaper applied: $(basename "$path")"
}

save_original() {
    if [[ -z "$original_wallpaper" && -f "$STATE_FILE" ]]; then
        local current
        current=$(cat "$STATE_FILE")
        # Only save if it's not already one of our generated wallpapers
        if [[ "$current" != "$CACHE"* ]]; then
            original_wallpaper="$current"
            log "Saved original wallpaper: $original_wallpaper"
        fi
    fi
}

restore_original() {
    if [[ -n "$original_wallpaper" && -f "$original_wallpaper" ]]; then
        log "Restoring original wallpaper..."
        set_wallpaper "$original_wallpaper"
        original_wallpaper=""
    fi
    restore_scheme
}

# ─── Scheme helpers ──────────────────────────────────────────────

# Extract the single most-dominant hex colour from an image file.
# Uses ImageMagick to quantise to 1 colour then read it back.
extract_dominant_color() {
    local img="$1"
    magick "$img" \
        -resize 50x50! \
        -colors 1 \
        -unique-colors \
        txt:- 2>/dev/null \
        | awk 'NR==2 { match($0, /#([0-9A-Fa-f]{6})/, a); print a[1] }'
}

# Save the currently active caelestia scheme so we can restore it later.
save_scheme() {
    $original_scheme_saved && return   # save only once per Spotify session
    local name flavour mode variant
    name=$(caelestia scheme get -n 2>/dev/null | tr -d '[:space:]')
    flavour=$(caelestia scheme get -f 2>/dev/null | tr -d '[:space:]')
    mode=$(caelestia scheme get -m 2>/dev/null | tr -d '[:space:]')
    variant=$(caelestia scheme get -v 2>/dev/null | tr -d '[:space:]')
    {
        echo "name=$name"
        echo "flavour=$flavour"
        echo "mode=$mode"
        echo "variant=$variant"
    } > "$SCHEME_STATE"
    original_scheme_saved=true
    log "Saved original scheme: ${name}/${flavour}/${mode}/${variant}"
}

# Apply a caelestia scheme derived from an album art dominant colour.
apply_scheme_from_cover() {
    local cover_path="$1"
    local hex
    hex=$(extract_dominant_color "$cover_path")

    if [[ -z "$hex" ]]; then
        log "WARN: Could not extract dominant colour — skipping scheme update"
        return
    fi

    log "Dominant album colour: #${hex} — applying scheme (mode=${SCHEME_MODE}, variant=${SCHEME_VARIANT})"
    caelestia scheme set \
        -n dynamic \
        -f "${hex}" \
        -m "${SCHEME_MODE}" \
        -v "${SCHEME_VARIANT}" \
        2>/dev/null && log "Scheme applied" || log "WARN: caelestia scheme set failed"
}

# Restore the scheme that was active before Spotify started.
restore_scheme() {
    if ! $original_scheme_saved; then
        return
    fi
    original_scheme_saved=false

    if [[ ! -f "$SCHEME_STATE" ]]; then
        log "No saved scheme state — nothing to restore"
        return
    fi

    log "Restoring original scheme..."
    # Re-source the key=value state file
    local name="" flavour="" mode="" variant=""
    while IFS='=' read -r key val; do
        case "$key" in
            name)    name="$val"    ;;
            flavour) flavour="$val" ;;
            mode)    mode="$val"    ;;
            variant) variant="$val" ;;
        esac
    done < "$SCHEME_STATE"

    local args=()
    [[ -n "$name" ]]    && args+=(-n "$name")
    [[ -n "$flavour" ]] && args+=(-f "$flavour")
    [[ -n "$mode" ]]    && args+=(-m "$mode")
    [[ -n "$variant" ]] && args+=(-v "$variant")

    if (( ${#args[@]} > 0 )); then
        caelestia scheme set "${args[@]}" 2>/dev/null \
            && log "Scheme restored (${name}/${flavour}/${mode}/${variant})" \
            || log "WARN: scheme restore failed"
    else
        log "Saved scheme state has no usable fields — restore skipped"
    fi
}

# ─── Wallpaper builder ───────────────────────────────────────────
build_wallpaper() {
    local url="$1" title="$2" artist="$3" slug="$4"
    local final="$CACHE/wall_${slug}.jpg"

    read -r W H < <(get_monitor_dims)
    W=${W:-1920}; H=${H:-1080}

    local cover="$CACHE/cover_${slug}.jpg"
    log "Downloading cover art..." >&2
    curl -s "$url" -o "$cover" 2>/dev/null

    if [[ ! -s "$cover" ]]; then
        log "ERROR: Cover download failed for $url" >&2
        return 1
    fi

    # Layout
    local COVER_X=$(( W/2 - COVER_SIZE/2 ))
    local COVER_Y=$(( H/2 - COVER_SIZE/2 + VERTICAL_OFFSET ))
    local LINE_Y=$(( COVER_Y + COVER_SIZE + 24 ))
    local TITLE_Y=$(( LINE_Y + 22 ))
    local ARTIST_Y=$(( TITLE_Y + 52 ))

    log "Building wallpaper at ${W}x${H}..." >&2

    # 1. Blurred + darkened background
    magick "$cover" \
        -resize "${W}x${H}^" -gravity center -extent "${W}x${H}" \
        -blur "0x${BLUR_STRENGTH}" \
        -fill black -colorize "${DARKEN_AMOUNT}%" \
        "$CACHE/bg.jpg" || return 1

    # 2. Square cover
    magick "$cover" \
        -resize "${COVER_SIZE}x${COVER_SIZE}!" \
        "$CACHE/cover_sq.png"

    # 3. Rounded corner mask
    magick -size "${COVER_SIZE}x${COVER_SIZE}" xc:black \
        -fill white \
        -draw "roundrectangle 0,0 $((COVER_SIZE-1)),$((COVER_SIZE-1)) ${RADIUS},${RADIUS}" \
        "$CACHE/mask.png"

    # 4. Apply mask → rounded cover
    magick "$CACHE/cover_sq.png" "$CACHE/mask.png" \
        -alpha off -compose CopyOpacity -composite \
        "$CACHE/cover_r.png"

    # 5. Drop shadow
    magick "$CACHE/mask.png" \
        -background none -fill black -colorize 100 \
        -alpha copy -shadow 60x18+0+8 \
        "$CACHE/shadow.png"

    # 6. Composite: bg + shadow + cover
    magick "$CACHE/bg.jpg" \
        \( "$CACHE/shadow.png" -geometry "+$((COVER_X - 18))+$((COVER_Y - 10))" \) -composite \
        \( "$CACHE/cover_r.png" -geometry "+${COVER_X}+${COVER_Y}" \) -composite \
        "$CACHE/comp.jpg"

    # 7. Divider line
    magick "$CACHE/comp.jpg" \
        -stroke "#ffffff55" -strokewidth 1 \
        -draw "line ${COVER_X},${LINE_Y} $((COVER_X + COVER_SIZE)),${LINE_Y}" \
        "$CACHE/lined.jpg"

    # 8. Title + artist text
    magick "$CACHE/lined.jpg" \
        -font "$FONT_BOLD" \
        -fill white -pointsize "$TITLE_SIZE" \
        -gravity northwest -annotate "+${COVER_X}+${TITLE_Y}" "$title" \
        -font "$FONT_REGULAR" \
        -fill "#aaaaaa" -pointsize "$ARTIST_SIZE" \
        -gravity northwest -annotate "+${COVER_X}+${ARTIST_Y}" "$artist" \
        "$final" || return 1

    # Cleanup temp files
    rm -f "$CACHE/bg.jpg" "$CACHE/cover_sq.png" "$CACHE/mask.png" \
          "$CACHE/cover_r.png" "$CACHE/shadow.png" \
          "$CACHE/comp.jpg" "$CACHE/lined.jpg"

    log "Wallpaper built successfully" >&2
    echo "$final"
}

# ─── Track change handler ──────────────────────────────────────────
handle_track() {
    local trackid="$1" url="$2" artist="$3" title="$4"

    # Fix open.spotify.com → i.scdn.co CDN URL
    if [[ "$url" == https://open.spotify.com/image/* ]]; then
        url="${url/open.spotify.com\/image/i.scdn.co\/image}"
    fi

    if [[ -z "$url" || "$url" != http* ]]; then
        log "No valid art URL — skipping"
        return
    fi

    save_original

    # Save the current scheme before changing it (once per session)
    if [[ "$MATCH_SCHEME" == "true" ]]; then
        save_scheme
    fi

    local slug="${trackid##*/}"
    local cover="$CACHE/cover_${slug}.jpg"
    local final="$CACHE/wall_${slug}.jpg"

    if [[ ! -f "$final" ]]; then
        local t a
        t=$(trunc "$title")
        a=$(trunc "$artist")
        final=$(build_wallpaper "$url" "$t" "$a" "$slug") || return
    else
        log "Using cached wallpaper"
    fi

    [[ -f "$final" ]] && set_wallpaper "$final"

    # Apply caelestia scheme from album dominant colour
    if [[ "$MATCH_SCHEME" == "true" ]]; then
        # Prefer the already-downloaded cover; fall back to fresh download
        if [[ ! -f "$cover" ]]; then
            cover="$CACHE/cover_tmp_${slug}.jpg"
            curl -s "$url" -o "$cover" 2>/dev/null
        fi
        [[ -s "$cover" ]] && apply_scheme_from_cover "$cover"
    fi
}

# ─── Main event loop ─────────────────────────────────────────────
log "spotify-plugin-caelestia starting (event-driven mode)"
log "Config: ${CONFIG}"
log "Cache:  ${CACHE}"

while true; do
    # Wait until Spotify is available
    if ! playerctl -p spotify status &>/dev/null; then
        log "Spotify not detected — waiting..."
        restore_original
        last_trackid=""
        while ! playerctl -p spotify status &>/dev/null; do
            sleep "$RETRY_DELAY"
        done
        log "Spotify detected — attaching..."
    fi

    # Event-driven: playerctl --follow streams a line on every metadata change.
    # Using process substitution keeps variables in the main shell scope.
    while IFS=$'\t' read -r status trackid arturl artist title; do
        if [[ "$status" == "Playing" ]]; then
            if [[ "$trackid" != "$last_trackid" && -n "$trackid" ]]; then
                log "Now playing: $title — $artist"
                last_trackid="$trackid"
                handle_track "$trackid" "$arturl" "$artist" "$title"
            fi
        else
            # Paused or stopped
            if [[ -n "$original_wallpaper" || "$original_scheme_saved" == "true" ]]; then
                log "Playback stopped — restoring wallpaper & scheme"
                restore_original
                last_trackid=""
            fi
        fi
    done < <(playerctl -p spotify --follow metadata \
        --format $'{{status}}\t{{mpris:trackid}}\t{{mpris:artUrl}}\t{{xesam:artist}}\t{{xesam:title}}' \
        2>/dev/null)

    log "playerctl exited (Spotify closed?) — retrying in ${RETRY_DELAY}s..."
    restore_original
    last_trackid=""
    sleep "$RETRY_DELAY"
done
